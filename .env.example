# Vercel (Turso) - production database
# Get these from https://console.turso.tech after creating a database
TURSO_DB_URL=https://your-db-username.aws-region.turso.io
TURSO_DB_TOKEN=your-turso-token

# JWT secret (generate a random string)
JWT_SECRET=your-secret-key-here

# Admin seed credentials (optional)
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123

# WhatsApp Cloud API (Meta) - https://developers.facebook.com > WhatsApp > Getting Started
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Test mode: restrict WhatsApp sending to specific numbers only (comma-separated).
# Accepts Saudi (05XXXXXXXX / +966...) or Egyptian (01XXXXXXXXX) formats.
# Leave EMPTY in production to allow sending to all parents.
WHATSAPP_ALLOWED_NUMBERS=
