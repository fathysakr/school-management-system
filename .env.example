# Vercel (Turso) - production database
# Get these from https://console.turso.tech after creating a database
TURSO_DB_URL=https://your-db-username.aws-region.turso.io
TURSO_DB_TOKEN=your-turso-token

# JWT secret (generate a random string)
JWT_SECRET=your-secret-key-here

# Admin seed credentials (optional)
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
